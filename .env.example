# Copy to .env for local use (scripts/set_webhook.py). On Vercel, add the same
# values under Project Settings > Environment Variables. Never commit .env.

# From @BotFather. The full token looks like 123456789:AAG...
TELEGRAM_BOT_TOKEN=
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Your numeric Telegram user ID. Only this user gets replies.
ALLOWED_TELEGRAM_USER_ID=
# Any long random string (letters, digits, _ and - only). Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
TELEGRAM_WEBHOOK_SECRET=

# Optional model overrides
# GEMINI_DRAFT_MODEL=gemini-pro-latest
# GEMINI_TRANSCRIBE_MODEL=gemini-flash-latest
